    macbook.pro:
  vars:
    ansible_user: iuad15au
    ansible_become: true
    ansible_connection: local
    ansible_python_interpreter: "{{ ansible_playbook_python }}"
    HOME_DIR: "/Users/{{ ansible_user }}"
    ONEDRIVE_DIR: "{{ HOME_DIR }}/Library/CloudStorage/OneDrive-RaiffeisenBankInternationalGroup"
