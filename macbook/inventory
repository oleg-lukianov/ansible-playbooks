macbook.pro:
  hosts:
    localhost:
      hostname: "macbook.pro"
      ALIASES: |-
        ## OLD ##
        # alias k9s-prod='k9s --kubeconfig ~/.kube/config-prod --context ~/.kube/config-prod'
        # alias sstp='/usr/bin/sudo {{ ONEDRIVE_DIR }}/scripts/connect_to_sstp.sh'

        ## Admins ##
        alias ll='ls -lah'
        alias k9s-prod='k9s --kubeconfig ~/.kube/kubeconfig-21.03.2023.yaml --context ~/.kube/kubeconfig-21.03.2023.yaml'
        alias k9slog='cd "{{ HOME_DIR }}/Library/Application Support/k9s/screen-dumps/"'
        alias auto='python3 {{ ONEDRIVE_DIR }}/scripts/autorun.py'
        alias sshh='{{ ONEDRIVE_DIR }}/scripts/sshh.sh'
        alias sshc='{{ ONEDRIVE_DIR }}/scripts/sshc.sh'
        alias ssha='{{ HOME_DIR }}/Documents/code.rbi.tech/dep_common/linux/ssh/ssha.sh'
        alias sshaa='python3 {{ HOME_DIR }}/Documents/code.rbi.tech/dep_common/linux/ssh/sshaa.py'
        alias gitrm='git branch -D `git branch | grep "LDO\|loans\|PLSUPP\|feat\|fix\|CMP" | xargs`'
        alias gitrmc='find . -name ".terragrunt-cache" -type d -exec rm -rf {} \;; find . -name ".terraform.lock.hcl" -type f -delete'
        alias gitrmcc='time {{ HOME_DIR }}/.scripts/gitrmcc.sh'
        alias awsc='{{ HOME_DIR }}/Documents/code.rbi.tech/dep_common/linux/aws/parse_credentials.sh'
        alias decr='ansible-vault decrypt --vault-password-file {{ HOME_DIR }}/Documents/code.rbi.tech/dep_common/loans-ansible-inventory/.vault_pass {{ HOME_DIR }}/Documents/code.rbi.tech/dep_common/loans-ansible-inventory/inventory'
        alias encr='ansible-vault encrypt --vault-password-file {{ HOME_DIR }}/Documents/code.rbi.tech/dep_common/loans-ansible-inventory/.vault_pass {{ HOME_DIR }}/Documents/code.rbi.tech/dep_common/loans-ansible-inventory/inventory'
        alias run-ansible='time {{ HOME_DIR }}/Documents/code.rbi.tech/dep_common/linux/ansible/run_ansible_for_all.sh'
        alias githubupdate='time {{ HOME_DIR }}/Documents/code.rbi.tech/dep_common/linux/code.rbi.tech/github_update.sh'
        alias brewupdate='time arch -arm64 brew upgrade && brew cleanup -s -n'

        ## cd ##
        alias home='cd "{{ ONEDRIVE_DIR }}"'
        alias code='cd {{ HOME_DIR }}/Documents/code.rbi.tech'
        alias down='cd {{ HOME_DIR }}/Downloads'

        ## Backup ##
        alias sm='{{ ONEDRIVE_DIR }}/scripts/sync_to_smart.sh'
        alias ba='{{ ONEDRIVE_DIR }}/scripts/backup_macbook.sh'
        alias smv='{{ ONEDRIVE_DIR }}/scripts/sync_to_smart_video.sh'

        ## Android ##
        alias asm='cp {{ HOME_DIR }}/AndroidStudioProjects/HMonitor2/app/release/app-release.apk {{ ONEDRIVE_DIR }}/smart_to/ && sm'
      EXPORTS: |-
        # PATH
        export PATH="$PATH:/opt/kroleg/mc/bin:/opt/homebrew/bin:/opt/homebrew/Cellar/python@3.14/3.14.3_1/bin:{{ HOME_DIR }}/bin:{{ HOME_DIR }}/Library/Android/sdk/tools/bin:{{ HOME_DIR }}/Library/Android/sdk/platform-tools:/opt/homebrew/Cellar/postgresql@18/18.1_1/bin:/opt/homebrew/Cellar/ansible@9/9.13.0_4/libexec/bin"
        export PATH="$PATH:/opt/homebrew/Cellar/terraform/1.5.7/bin:/opt/homebrew/opt/inetutils/libexec/gnubin"
        export JAVA_HOME="/System/Volumes/Data{{ HOME_DIR }}/Library/Java/JavaVirtualMachines/liberica-1.8.0_392/bin"
        export TERMINFO=/usr/share/terminfo

        # language
        export LC_ALL=en_US.UTF-8  
        export LANG=en_US.UTF-8

        # for ansible
        export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

        # for AWS cli
        export AWS_DEFAULT_REGION=eu-central-1
        export NODE_EXTRA_CA_CERTS=/usr/local/etc/pki/rbua.pem
        export REQUEST_CA_CERTS=/usr/local/etc/pki/rbua.pem
        export REQUESTS_CA_BUNDLE=/usr/local/etc/pki/rbua.pem
        export AWS_CA_BUNDLE=/usr/local/etc/pki/rbua.pem
        export CURL_CA_BUNDLE=/usr/local/etc/pki/rbua.pem

        # proxy
        # export http_proxy="https://proxy.its.rbua:8000"
        # export https_proxy="https://proxy.its.rbua:8000"
        # export no_proxy="127.0.0.1,localhost"
        # export HTTP_PROXY="https://proxy.its.rbua:8000"
        # export HTTPS_PROXY="https://proxy.its.rbua:8000"
        # export NO_PROXY="127.0.0.1,localhost"

      SSH_CONFIG: |-
        Host nas
          HostName 10.225.102.4
          # HostKeyAlgorithms +ssh-dss
          # PubkeyAcceptedKeyTypes +ssh-rsa

        Host i-0a05b266d5d6b05aa
          User iuad15au
          ProxyCommand sh -c "aws ssm start-session --no-verify-ssl --target %h --document-name AWS-StartSSHSession --parameters 'portNumber=%p'"

        Host i-04156a30a8bb138da
          User iuad15au
          ProxyCommand sh -c "aws ssm start-session --debug --no-verify-ssl --target %h --document-name AWS-StartSSHSession --parameters 'portNumber=%p' --cli-read-timeout 60 --cli-connect-timeout 60"

        Host zbx-node-1.pro
          HostName 192.168.2.197
          Port 8021

        Host zbx-node-2.pro
          HostName 192.168.2.197
          Port 8022

        Host zbx-node-3.pro
          HostName 192.168.2.197
          Port 8023

        Host erlan.pro
          HostName 192.168.2.197
          Port 22

        Host m52.pro
          HostName 192.168.2.198
          Port 8022

        Host a71.pro
          HostName 192.168.2.192
          Port 8022

        Host 9.pro
          HostName 192.168.1.195
          Port 8022

        Host sabit.pro
          HostName 192.168.2.1
          Port 22

        Host duman.pro
          HostName 192.168.2.199
          Port 22

        Host a72.pro
